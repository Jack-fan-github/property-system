page { background: #f4f7fb; color: #172033; padding-bottom: 150rpx; font-family: -apple-system, BlinkMacSystemFont, "PingFang SC", sans-serif; }
.container { min-height: 100vh; }
.status-banner { padding: 34rpx 32rpx 48rpx; color: #fff; }
.bg-pending { background: linear-gradient(145deg,#d97706,#f59e0b); } .bg-processing { background: linear-gradient(145deg,#1d4ed8,#2563eb); } .bg-completed { background: linear-gradient(145deg,#047857,#0f9f78); }
.banner-content { display: flex; align-items: center; }
.status-icon-area { width: 70rpx; height: 70rpx; margin-right: 16rpx; display: flex; align-items: center; justify-content: center; border-radius: 18rpx; background: rgba(255,255,255,.18); }
.status-icon-text { font-size: 32rpx; } .status-text-area { flex: 1; }
.banner-status { display: block; margin-bottom: 5rpx; font-size: 31rpx; font-weight: 700; } .banner-desc { font-size: 20rpx; opacity: .86; }
.content-body { margin-top: -20rpx; padding: 0 28rpx 30rpx; position: relative; }
.card { margin-bottom: 16rpx; padding: 22rpx; display: flex; flex-direction: column; background: #fff; border: 1rpx solid #e7edf5; border-radius: 16rpx; box-shadow: 0 5rpx 16rpx rgba(30,55,90,.06); }
.card-header-row { display: flex; align-items: center; justify-content: space-between; margin-bottom: 16rpx; padding-bottom: 13rpx; border-bottom: 1rpx solid #eef2f7; }
.card-title { padding-left: 12rpx; border-left: 5rpx solid #2563eb; color: #26364d; font-size: 27rpx; font-weight: 700; line-height: 1.2; }
.maintenance-title { border-left-color: #0f9f78; }
.maintenance-note { margin: 12rpx 0 2rpx; color: #718096; font-size: 21rpx; }
.priority-tag { padding: 5rpx 10rpx; border-radius: 10rpx; font-size: 18rpx; } .tag-normal { color: #2563eb; background: #eff6ff; } .tag-urgent { color: #dc2626; background: #fef2f2; }
.info-grid { display: flex; flex-wrap: wrap; gap: 17rpx 12rpx; } .info-block { width: calc(50% - 6rpx); display: flex; flex-direction: column; } .info-block.full-width { width: 100%; }
.info-block .label { margin-bottom: 5rpx; color: #94a3b8; font-size: 21rpx; } .info-block .value { color: #334155; font-size: 24rpx; line-height: 1.4; } .value.highlight { color: #2563eb; font-weight: 600; } .mono { font-family: monospace; }
.detail-card { min-height: 270rpx; box-sizing: border-box; } .desc-box { min-height: 125rpx; padding: 16rpx; display: flex; align-items: flex-start; background: #f8fafc; border-radius: 11rpx; } .desc-text { color: #475569; font-size: 24rpx; line-height: 1.65; }
.image-list { display: flex; flex-wrap: wrap; gap: 12rpx; margin-top: 16rpx; } .detail-img { width: 142rpx; height: 142rpx; border-radius: 10rpx; background: #eef2f7; }
.contact-row { display: flex; align-items: center; padding-top: 5rpx; } .contact-avatar-wrapper { margin-right: 15rpx; } .contact-avatar { width: 66rpx; height: 66rpx; display: flex; align-items: center; justify-content: center; border-radius: 17rpx; color: #2563eb; background: #e8f0ff; font-size: 27rpx; font-weight: 700; }
.contact-info { min-width: 0; flex: 1; } .contact-name { display: block; margin-bottom: 7rpx; color: #26364d; font-size: 25rpx; font-weight: 700; } .phone-line,.address-line { display: flex; align-items: center; margin-top: 4rpx; color: #718096; font-size: 21rpx; } .icon-small { width: 24rpx; margin-right: 5rpx; color: #94a3b8; }
.call-btn-circle { width: 62rpx; height: 62rpx; margin-left: 12rpx; display: flex; align-items: center; justify-content: center; border-radius: 50%; background: #e8f7f1; } .phone-icon { font-size: 28rpx; }
.img-grid { display: grid; grid-template-columns: repeat(3,1fr); gap: 10rpx; } .img-item,.img-add { position: relative; height: 170rpx; border-radius: 10rpx; overflow: hidden; } .img { width: 100%; height: 100%; } .img-add { display: flex; flex-direction: column; align-items: center; justify-content: center; border: 1rpx dashed #cbd5e1; color: #94a3b8; background: #f8fafc; } .add-icon { font-size: 34rpx; } .add-text { font-size: 18rpx; } .remove { position: absolute; top: 3rpx; right: 7rpx; color: #fff; font-size: 28rpx; text-shadow: 0 1rpx 4rpx #000; }
.full-width-btn { width: 100%; height: 76rpx; line-height: 76rpx; margin-top: 20rpx; border-radius: 38rpx; font-size: 24rpx; } .primary-btn,.accept-btn { color: #fff; background: #2563eb; }
.bottom-bar-wrapper { position: fixed; left: 0; bottom: 0; z-index: 99; width: 100%; padding: 16rpx 28rpx calc(16rpx + env(safe-area-inset-bottom)); box-sizing: border-box; background: #fff; box-shadow: 0 -4rpx 16rpx rgba(30,55,90,.08); } .bottom-float-btn { width: 100%; height: 74rpx; line-height: 74rpx; border-radius: 37rpx; font-size: 24rpx; }
.eval-content-box,.reply-content { color: #475569; font-size: 21rpx; line-height: 1.55; } .score-big { font-size: 46rpx; } .empty-eval { padding: 30rpx 0; color: #94a3b8; text-align: center; font-size: 20rpx; }
