page { background: #f4f7fb; color: #172033; font-family: -apple-system, BlinkMacSystemFont, "PingFang SC", sans-serif; }
.container { display: flex; flex-direction: column; height: 100vh; }
.sticky-header { position: relative; z-index: 2; padding-bottom: 18rpx; }
.header-bg { position: absolute; inset: 0 0 auto; height: 250rpx; z-index: -1; background: linear-gradient(145deg, #1d4ed8, #2563eb 58%, #0f9f78); border-radius: 0 0 30rpx 30rpx; }
.page-title-area { height: 128rpx; padding: 16rpx 32rpx 0; display: flex; align-items: center; }
.title-main { display: flex; flex-direction: column; }
.title-text { color: #fff; font-size: 34rpx; font-weight: 700; }
.subtitle-text { margin-top: 8rpx; color: rgba(255,255,255,.78); font-size: 20rpx; }
.stats-card { margin: 0 28rpx; padding: 20rpx 0; display: flex; align-items: center; background: #fff; border-radius: 17rpx; box-shadow: 0 8rpx 22rpx rgba(26,55,100,.12); }
.stat-item { flex: 1; position: relative; display: flex; flex-direction: column; align-items: center; padding: 3rpx 0; }
.stat-num { margin-bottom: 5rpx; color: #64748b; font-size: 29rpx; font-weight: 700; }
.stat-label { color: #94a3b8; font-size: 20rpx; }
.active-num,.active-label { color: #2563eb; }
.active-label { font-weight: 600; }
.stat-indicator { position: absolute; bottom: -14rpx; width: 24rpx; height: 4rpx; border-radius: 3rpx; background: #2563eb; }
.stat-divider { width: 1rpx; height: 34rpx; background: #e5eaf1; }
.list-container { flex: 1; box-sizing: border-box; padding: 18rpx 28rpx 36rpx; }
.order-card { position: relative; overflow: hidden; margin-bottom: 16rpx; padding: 0; background: #fff; border: 1rpx solid #e7edf5; border-radius: 16rpx; box-shadow: 0 5rpx 16rpx rgba(30,55,90,.06); }
.card-decoration { position: absolute; top: -55rpx; right: -38rpx; z-index: 0; width: 130rpx; height: 130rpx; border-radius: 50%; background: #eff6ff; pointer-events: none; }
.card-header { position: relative; z-index: 1; display: flex; align-items: center; justify-content: space-between; padding: 17rpx 20rpx 13rpx; border-bottom: 1rpx solid #f0f3f7; }
.header-left { display: flex; align-items: center; }
.priority-badge { display: flex; align-items: center; padding: 4rpx 10rpx; border-radius: 12rpx; font-size: 18rpx; font-weight: 600; }
.badge-dot { width: 8rpx; height: 8rpx; margin-right: 5rpx; border-radius: 50%; }
.priority-badge.normal { color: #2563eb; background: #eff6ff; } .priority-badge.normal .badge-dot { background: #2563eb; }
.priority-badge.urgent { color: #dc2626; background: #fef2f2; } .priority-badge.urgent .badge-dot { background: #dc2626; }
.order-id,.order-time { color: #94a3b8; font-size: 19rpx; }
.order-id { margin-left: 10rpx; } .card-body { position: relative; z-index: 1; display: flex; align-items: flex-start; justify-content: space-between; padding: 18rpx 20rpx; }
.main-info { min-width: 0; flex: 1; padding-right: 12rpx; }
.category-name { display: block; margin-bottom: 7rpx; color: #26364d; font-size: 26rpx; font-weight: 700; }
.desc-text { display: -webkit-box; overflow: hidden; color: #718096; font-size: 21rpx; line-height: 1.45; -webkit-box-orient: vertical; -webkit-line-clamp: 2; }
.status-ring { padding: 6rpx 10rpx; border-radius: 9rpx; font-size: 19rpx; font-weight: 600; white-space: nowrap; }
.status-ring.pending { color: #b45309; background: #fffbeb; } .status-ring.processing { color: #2563eb; background: #eff6ff; } .status-ring.completed { color: #15803d; background: #f0fdf4; }
.card-footer { display: flex; align-items: center; justify-content: space-between; padding: 12rpx 20rpx; background: #f8fafc; }
.location-info { display: flex; align-items: center; max-width: 75%; overflow: hidden; color: #718096; font-size: 19rpx; white-space: nowrap; text-overflow: ellipsis; }
.icon-loc { margin-right: 5rpx; font-size: 18rpx; }
.action-btn { padding: 7rpx 18rpx; border-radius: 14rpx; color: #fff; background: #2563eb; font-size: 19rpx; font-weight: 600; }
.empty-state { display: flex; flex-direction: column; align-items: center; padding-top: 100rpx; }
.empty-icon { margin-bottom: 14rpx; opacity: .45; font-size: 58rpx; } .empty-text { margin-bottom: 6rpx; color: #64748b; font-size: 25rpx; font-weight: 600; } .empty-sub { color: #94a3b8; font-size: 20rpx; }
.bottom-spacer { height: 30rpx; }
