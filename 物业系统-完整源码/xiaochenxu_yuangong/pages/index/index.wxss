page { background: #f4f7fb; color: #172033; font-family: -apple-system, BlinkMacSystemFont, "PingFang SC", sans-serif; }
.container { min-height: 100vh; }
.hero { padding: 48rpx 32rpx 34rpx; background: linear-gradient(145deg, #1d4ed8, #2563eb 58%, #0f9f78); border-radius: 0 0 36rpx 36rpx; }
.hero-top { display: flex; align-items: baseline; justify-content: space-between; }
.app-title { font-size: 36rpx; font-weight: 700; letter-spacing: 1rpx; }
.app-subtitle { font-size: 20rpx; opacity: .72; }
.hero-card { margin-top: 30rpx; padding: 24rpx; display: flex; align-items: center; background: rgba(255,255,255,.97); border-radius: 20rpx; box-shadow: 0 14rpx 30rpx rgba(15,42,90,.16); }
.avatar-box { position: relative; margin-right: 18rpx; }
.avatar { width: 82rpx; height: 82rpx; display: flex; align-items: center; justify-content: center; border-radius: 20rpx; background: #e8f0ff; color: #2563eb; font-size: 32rpx; font-weight: 700; }
.status-badge { position: absolute; right: -8rpx; bottom: -8rpx; padding: 3rpx 9rpx; border: 3rpx solid #fff; border-radius: 14rpx; background: #16a34a; color: #fff; font-size: 17rpx; }
.info { min-width: 0; flex: 1; }
.name-row { display: flex; align-items: center; margin-bottom: 8rpx; }
.name { max-width: 230rpx; overflow: hidden; text-overflow: ellipsis; white-space: nowrap; color: #172033; font-size: 29rpx; font-weight: 700; }
.tag { margin-left: 10rpx; padding: 4rpx 9rpx; border-radius: 7rpx; background: #e8f0ff; color: #2563eb; font-size: 17rpx; }
.role { color: #718096; font-size: 21rpx; }
.hero-actions { padding: 10rpx 15rpx; border-radius: 18rpx; background: #f1f5f9; color: #64748b; font-size: 20rpx; }
.action-text { font-size: 20rpx; }
.content { margin-top: 28rpx; padding: 0 32rpx 40rpx; position: relative; }
.section-title { margin: 0 0 22rpx 4rpx; color: #334155; font-size: 25rpx; font-weight: 700; }
.menu-grid { display: flex; flex-direction: column; gap: 18rpx; }
.menu-item { min-height: 82rpx; padding: 20rpx 24rpx; display: flex; align-items: center; background: #fff; border: 1rpx solid #e7edf5; border-radius: 16rpx; box-shadow: 0 6rpx 18rpx rgba(30,55,90,.06); }
.menu-hover { background: #f8fbff; transform: translateY(1rpx); }
.icon-box { width: 58rpx; height: 58rpx; margin-right: 14rpx; display: flex; align-items: center; justify-content: center; border-radius: 15rpx; }
.icon-text { font-size: 25rpx; font-weight: 700; }
.menu-name { color: #26364d; font-size: 23rpx; font-weight: 600; }
