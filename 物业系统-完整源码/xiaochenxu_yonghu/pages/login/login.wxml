<view class="container login-container">
  <view class="header-section">
    <view class="logo-box">
      <image class="logo" src="/assets/default-avatar.png" mode="aspectFit"></image>
    </view>
    <text class="app-name">智慧物业</text>
    <text class="slogan">让生活更美好</text>
  </view>

  <view class="form-section">
    <!-- 账号密码登录 -->
    <block wx:if="{{loginMode === 'password'}}">
      <view class="input-item">
        <input class="input" type="text" placeholder="用户名或手机号" placeholder-class="placeholder" model:value="{{username}}" />
      </view>
      <view class="input-item">
        <input class="input" type="password" password="true" placeholder="请输入密码" placeholder-class="placeholder" model:value="{{password}}" />
      </view>
    </block>

    <!-- 手机验证码登录 -->
    <block wx:else>
      <view class="input-item">
        <input class="input" type="number" placeholder="请输入手机号" placeholder-class="placeholder" model:value="{{phone}}" maxlength="11" />
      </view>
      <view class="sms-row">
        <input class="input sms-input" type="number" placeholder="短信验证码" placeholder-class="placeholder" model:value="{{smsCode}}" maxlength="6" />
        <button class="btn-sms" size="mini" bindtap="sendSmsCode" disabled="{{smsCountdown > 0}}">
          {{smsCountdown > 0 ? smsCountdown + 's' : '获取验证码'}}
        </button>
      </view>
    </block>

    <view class="action-links">
      <text bindtap="goToRegister">注册账号</text>
      <text>忘记密码</text>
    </view>

    <button class="btn-login" bindtap="handleLogin" hover-class="btn-hover">{{loginMode === 'password' ? '登 录' : '登 录'}}</button>

    <view class="mode-switch" bindtap="switchMode">
      {{loginMode === 'password' ? '使用手机验证码登录' : '使用账号密码登录'}}
    </view>

    <view class="divider">
      <view class="line"></view>
      <text>其他登录方式</text>
      <view class="line"></view>
    </view>

    <button class="btn-wechat" bindtap="handleWeChatLogin" hover-class="btn-hover">
      <text class="iconfont">💬</text> 微信一键登录
    </button>
  </view>
</view>
